# --- Training data ---
# Tokenized bins (754MB) and the raw corpus (6GB) are far too large for Git.
# train_slm.py downloads them from Hugging Face Hub on demand; see --hf-repo-id.
*.bin
*.zip
data/
data-*/
bangla_corpus*.txt

# --- OS cruft ---
Thumbs.db
.DS_Store
